# ========================================
# Streamlit Cloud Secrets Configuration
# ========================================
# 
# HOW TO USE:
# 1. Copy this file's content
# 2. Go to your Streamlit Cloud app dashboard
# 3. Click Settings → Secrets
# 4. Paste and update with your actual credentials
# 
# DO NOT commit the actual secrets.toml with real credentials!
# ========================================

# NCBI Entrez Credentials (Required for PubMed API)
ENTREZ_EMAIL = "your_email@example.com"
ENTREZ_API_KEY = "your_ncbi_api_key_here"

# Ollama Cloud API Configuration
OLLAMA_MODEL = "gptoss-120b:cloud"
OLLAMA_API_KEY = "your_ollama_cloud_api_key_here"

# ========================================
# Getting API Keys:
# 
# NCBI API Key:
# 1. Create account at: https://www.ncbi.nlm.nih.gov/account/
# 2. Go to Settings → API Key Management
# 3. Create a new API key
#
# Ollama Cloud API Key:
# 1. Sign up/login at: https://ollama.com
# 2. Go to: https://ollama.com/settings/keys
# 3. Create a new API key
# ========================================
